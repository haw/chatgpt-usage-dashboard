# Workspace-scoped ChatGPT Admin API key with enterprise.analytics.usage.read.
OPENAI_ADMIN_KEY=

# Override only when the authenticated Admin API reference shows another URL.
OPENAI_ANALYTICS_URL=https://api.chatgpt.com/v1/analytics/usage

DATA_DIR=/app/data
# local: DATA_DIRへ保存 / s3: ECSタスクロール等のAWS認証でS3へ保存
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=chatgpt-dashboard
# AWS_REGION=ap-northeast-1
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# 認証。none（既定、ローカル）または google（Google Workspace の OIDC ログイン）
AUTH_MODE=none
# AUTH_MODE=google のとき必須
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
AUTH_ALLOWED_DOMAINS=haw.co.jp
# プロキシ配下で外部 URL が内部と異なるとき（コールバック URL と Secure Cookie に使う）
# BASE_URL=https://dashboard.example.com
