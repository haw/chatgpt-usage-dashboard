DATA_DIR=/app/data
# local: DATA_DIRへ保存 / s3: ECSタスクロール等のAWS認証でS3へ保存
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=chatgpt-dashboard
# AWS_REGION=ap-northeast-1
# 本番でビルド済み React を同じコンテナから配信する場合のみ（通常は S3 + CloudFront）
# FRONTEND_DIST=/app/frontend/dist

# 認証。none（既定、ローカル）または google（Google Workspace の OIDC ログイン）
AUTH_MODE=none
# AUTH_MODE=google のとき必須
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
AUTH_ALLOWED_DOMAINS=haw.co.jp
# プロキシ配下で外部 URL が内部と異なるとき（コールバック URL と Secure Cookie に使う）
# BASE_URL=https://dashboard.example.com
