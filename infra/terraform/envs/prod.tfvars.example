# Copy to prod.tfvars (ignored by git) and adjust.
aws_region           = "ap-northeast-1"
environment          = "prod"
github_repository    = "haw/chatgpt-usage-dashboard"
auth_allowed_domains = ["haw.co.jp"]
data_retention_days  = 0

# Domain under the dev.haw.biz Route53 zone (also hosts the API origin name below).
domain_name     = "chatgpt-dashboard.dev.haw.biz"
route53_zone_id = "" # aws route53 list-hosted-zones-by-name --dns-name dev.haw.biz --query 'HostedZones[0].Id'
api_hostname    = "api.chatgpt-dashboard.dev.haw.biz"

# Existing ALB the API shares (haw-dev-load-balancer, the one ken.haw.biz and the dev.haw.biz apps ride on).
# The task uses the ALB's own subnets unless task_subnet_ids is set.
shared_alb_arn = "arn:aws:elasticloadbalancing:ap-northeast-1:<account>:loadbalancer/app/haw-dev-load-balancer/<id>"

