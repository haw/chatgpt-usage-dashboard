# `make tf-bootstrap` creates this project's state bucket and writes prod.backend.hcl (ignored by git)
# for you. The bucket is <project>-terraform-state-<AWS account id>; 123456789012 is a placeholder.
bucket       = "chatgpt-usage-dashboard-terraform-state-123456789012"
key          = "chatgpt-usage-dashboard/prod/terraform.tfstate"
region       = "ap-northeast-1"
use_lockfile = true
encrypt      = true
